# ─────────────────────────────────────────────────────────────────
# .env — all secrets and per-host config (gitignored)
# Copy to `.env` and fill in. Shared non-secret constants live in
# .env.common (committed). Keep this file mode 600.
#   cp .env.example .env && nano .env
# ─────────────────────────────────────────────────────────────────

# ── Cloudflare (Caddy DNS challenge + DDNS) ──────────────────────
# One scoped token used by Caddy (cert DNS-01) and the favonia DDNS updaters.
CLOUDFLARE_API_TOKEN=          # token for example.com: Zone:Read + Zone:DNS:Edit

# ── Tailscale ────────────────────────────────────────────────────
# No key needed. tailscaled is a host systemd unit since 2026-07-31 and its node
# identity lives in ~/data/tailscale, which borg covers; TS_AUTHKEY was only ever
# read by the retired tailscale/ compose stack. A rebuild authenticates once,
# interactively, with `sudo tailscale up`.

# ── CrowdSec ─────────────────────────────────────────────────────
ENROLL_KEY=                    # cscli console enroll key
# Caddy bouncer API key — generate with: cscli bouncers add caddy-bouncer -o raw
CROWDSEC_BOUNCER_KEY=

# ── Diun (image update notifications) ────────────────────────────
DISCORD_WEBHOOKURL=            # https://discord.com/api/webhooks/...


# ── Homepage widget credentials (read by the public Homepage stack) ──
PLEX_API_KEY=
HOMEASSISTANT_API_KEY=

# ── AdGuard Home (primary + Raspberry Pi replica / sync) ─────────
ADGUARD_USER=
ADGUARD_PASS=
ADGUARD_BACKUP_USER=
ADGUARD_BACKUP_PASS=

# ── Samba ────────────────────────────────────────────────────────
SAMBA_PASS=

# ── Bitcoin node (RPC) ───────────────────────────────────────────
RPC_PASSWORD=


# ── Uptime Kuma (Homepage status widget) ─────────────────────────
UPTIMEKUMA_SLUG=

# ── Scrutiny (S.M.A.R.T. disk alerts) ────────────────────────────
# Apprise URL(s), space-separated, e.g. discord://<token>@<channel_id>
# Never put this in scrutiny/scrutiny.yaml, where it lived until 2026-07-26: that
# file is tracked AND republished by the public mirror, so the webhook reached both
# git histories. It has since been rotated — and rotating is only half of it: delete
# the old webhook in Discord as well, or the exposed URL keeps working. The mirror's
# leak guard now checks for the shape of a credential, not just for known ones.
SCRUTINY_NOTIFY_URLS=

# ── Borgmatic ────────────────────────────────────────────────────
# Optional dead-man's-switch ping (healthchecks.io / Uptime Kuma push URL).
BORGMATIC_PINGURL=
# Borg repository passphrase — encrypts BOTH the on-site and the Hetzner repo
# client-side. STORE IT OFFSITE TOO: without it both copies are unrecoverable
# ciphertext, and it can never be rotated without re-initing both repos.
BORG_PASSPHRASE=

# ── Minecraft (itzg/minecraft-server) ────────────────────────────
TYPE=PAPER
VERSION=LATEST
MEMORY=4G
MAX_PLAYERS=20
MOTD=
USE_AIKAR_FLAGS=true
USE_MEOWICE_FLAGS=false
SPIGET_RESOURCES=
MODRINTH_PROJECTS=
